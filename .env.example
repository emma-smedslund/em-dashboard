# Jira Cloud values are read only by the Vercel server function. Never prefix
# secrets with VITE_, because Vite exposes those variables to the browser.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_PROJECT_KEY=TFP
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=

# Optional override. The default includes active work plus issues completed in
# the last 28 days, which is required for the rolling cycle-time comparison.
# JIRA_JQL=project = TFP AND (statusCategory != Done OR resolved >= -28d) ORDER BY updated DESC

# Slack bot token is server-only. Never prefix this with VITE_ and never
# commit a populated local environment file.
SLACK_BOT_TOKEN=
